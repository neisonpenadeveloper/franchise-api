# Copia este archivo a terraform.tfvars y rellena los valores reales.
# terraform.tfvars esta en .gitignore: no se sube al repositorio.

atlas_org_id = "TU_ORG_ID_DE_ATLAS"
project_name = "franchise-api"
cluster_name = "franchise-cluster"
region       = "US_EAST_1"

# La password NO se pone aqui: se exporta como variable de entorno antes de aplicar.
#   Linux/macOS : export TF_VAR_db_password='...'
#   PowerShell  : $env:TF_VAR_db_password='...'

# En una demo se deja abierto; en un entorno real, la IP de salida del servicio.
allowed_cidr_blocks = ["0.0.0.0/0"]
